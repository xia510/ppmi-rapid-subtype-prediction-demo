# start_demo.bat copies this file to the local .env when needed.
# The generated .env is ignored by Git and must never be committed.

# Required only when clicking the optional DeepSeek explanation button.
DEEPSEEK_API_KEY=

# Optional Python executable. The launcher also detects the active Conda
# environment and the default pd-mci environment automatically.
PYTHON_EXE=

# Optional DeepSeek model override.
DEEPSEEK_MODEL=deepseek-flash

# Optional path to a previously exported local model bundle.
PPMI_MODEL_ARTIFACT=artifacts/model_bundle.joblib

# Optional address used by Streamlit to call the local FastAPI service.
PPMI_API_BASE_URL=http://127.0.0.1:8000

# Optional path to the locally generated medical-literature vector index.
PPMI_LITERATURE_INDEX=knowledge_base/index
